# Skopiuj jako .env, uzupelnij sekrety i nie dodawaj tego pliku do Git.
BASE_DIR=/home/user/home-services
# Opcjonalne; domyslnie setup sam uzywa eth0 i wlan0.
ETH_INTERFACE=eth0
WLAN_INTERFACE=wlan0
PI_IP_CIDR=192.168.1.14/24
PI_IP=192.168.1.14
ROUTER_IP=192.168.1.1
DHCP_START=192.168.1.20
DHCP_END=192.168.1.250
DHCP_NETMASK=255.255.255.0
DHCP_LEASE_TIME=24h
UPSTREAM_DNS_1=1.1.1.1
UPSTREAM_DNS_2=8.8.8.8
TIMEZONE=Europe/Warsaw

DHCP_HOST_1=10:5B:AD:A1:55:A9,192.168.1.15,laptop,24h
DHCP_HOST_2=50:91:E2:21:BA:17,192.168.1.12,stacjonarny,24h
DHCP_HOST_3=00:11:22:33:44:55,192.168.1.7,telewizor,24h

PIHOLE_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_A_DIFFERENT_LONG_PASSWORD
TAILSCALE_AUTHKEY=
TAILSCALE_HOSTNAME=raspberry-home

JELLYFIN_HTTP_PORT=8096
JELLYFIN_HTTPS_PORT=8920
GRAFANA_PORT=3000
MEDIA_MOUNT_DIR=/mnt/Expansion
MEDIA_DISK_UUID=010A-F2E7
MEDIA_DISK_TYPE=exfat

PIHOLE_IMAGE=pihole/pihole:2026.05.0
TAILSCALE_IMAGE=tailscale/tailscale:v1.98.8
JELLYFIN_IMAGE=jellyfin/jellyfin:10.11.11
GRAFANA_IMAGE=grafana/grafana:13.1.0
PROMETHEUS_IMAGE=prom/prometheus:v3.11.3
NODE_EXPORTER_IMAGE=quay.io/prometheus/node-exporter:v1.12.1
CADVISOR_IMAGE=gcr.io/cadvisor/cadvisor:v0.60.5
BLACKBOX_IMAGE=quay.io/prometheus/blackbox-exporter:v0.28.0
PIHOLE_EXPORTER_IMAGE=ekofr/pihole-exporter:v1.2.0
